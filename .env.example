# ============================================
# MyStore - Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Render Backend (set these in Render Dashboard) ---

# Server port (Render sets this automatically)
PORT=3000

# Gmail SMTP (for password reset emails)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Video Server URL (Cloudflare Tunnel public URL)
# Example: https://video.yourdomain.com
# Leave empty to use legacy local storage mode
VIDEO_SERVER_URL=

# Video Server Internal URL (for Render→video server communication)
# If your tunnel is accessible at the same URL, leave this empty
# Example: https://video.yourdomain.com
VIDEO_SERVER_INTERNAL_URL=

# Shared API key for Render↔Video server communication
# Generate a strong random string (32+ characters)
VIDEO_SERVER_API_KEY=

# Secret for signing upload tokens (HMAC-SHA256)
# Generate a strong random string (32+ characters)
# MUST be the same on both Render and the video server
UPLOAD_TOKEN_SECRET=


# --- Local Video Server (set these on your Windows PC) ---

# Port for the local video server
VIDEO_SERVER_PORT=4000

# Directory where video files are stored
# Use forward slashes or escaped backslashes
VIDEO_STORAGE_DIR=D:/NetStream/videos

# API key (must match VIDEO_SERVER_API_KEY on Render)
VIDEO_SERVER_API_KEY=

# Upload token secret (must match UPLOAD_TOKEN_SECRET on Render)
UPLOAD_TOKEN_SECRET=
